{
  "name": "xpl",
  "version": "0.1.0",
  "description": "AI-guided step-by-step code diff explainer (Codex)",
  "license": "MIT",
  "bin": {
    "xpl": "bin/xpl.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "tsx --test server/*.test.ts",
    "test:ui": "vitest run",
    "test:coverage": "npm run test:coverage:server && npm run test:coverage:ui",
    "test:coverage:server": "node --import tsx --test --experimental-test-coverage --test-coverage-include='server/*.ts' --test-coverage-exclude='server/*.test.ts' server/*.test.ts",
    "test:coverage:ui": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "jsdom": "^31.0.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
